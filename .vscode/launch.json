{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "HomeLift API (dev)",
      "type": "java",
      "request": "launch",
      "mainClass": "app.homelift.HomeLiftApplication",
      "projectName": "homelift",
      "cwd": "${workspaceFolder}/backend",
      "vmArgs": "--enable-native-access=ALL-UNNAMED",
      "env": { "SPRING_PROFILES_ACTIVE": "dev" },
      "console": "integratedTerminal"
    },
    {
      "name": "HomeLift UI (Chrome)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "ng serve",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "HomeLift (full stack)",
      "configurations": ["HomeLift API (dev)", "HomeLift UI (Chrome)"],
      "stopAll": true
    }
  ]
}
