{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/**", "/media/**", "/*.(svg|png|woff2|woff)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "downloads-and-lock",
      "urls": ["/api/export/**", "/api/auth", "/api/auth/**"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 0, "maxAge": "0u", "timeout": "10s" }
    },
    {
      "name": "exercise-media",
      "urls": ["/api/exercises/*/media/*"],
      "cacheConfig": { "strategy": "performance", "maxSize": 80, "maxAge": "30d" }
    },
    {
      "name": "api",
      "urls": ["/api/**"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 300, "maxAge": "14d", "timeout": "4s" }
    }
  ],
  "navigationUrls": ["/**", "!/api/**", "!/actuator/**", "!/**/*.*"]
}
