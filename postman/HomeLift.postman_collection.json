                  "value": "CHEST"
                },
                {
                  "key": "includeArchived",
                  "value": "false"
                }
              ]
            },
            "description": "Search by name (q) and filter by muscle group: CHEST, BACK, SHOULDERS, LEGS, ARMS, CORE, FULL_BODY. Saves the first id as {{exerciseId}}."
